`timescale 1ns/1ps

module demux1to4_tb;

reg D;
reg S0;
reg S1;

wire Y0;
wire Y1;
wire Y2;
wire Y3;

demux1to4 uut (
    .D(D),
    .S0(S0),
    .S1(S1),
    .Y0(Y0),
    .Y1(Y1),
    .Y2(Y2),
    .Y3(Y3)
);

initial begin

    $dumpfile("demux.vcd");
    $dumpvars(0, demux1to4_tb);

    $display("Time\tD S1 S0\tY3 Y2 Y1 Y0");

    D = 1;

    S1 = 0; S0 = 0; #10;
    S1 = 0; S0 = 1; #10;
    S1 = 1; S0 = 0; #10;
    S1 = 1; S0 = 1; #10;

    $finish;
end

initial begin
    $monitor("%0t\t%b %b %b\t%b  %b  %b  %b",
             $time, D, S1, S0, Y3, Y2, Y1, Y0);
end

endmodule